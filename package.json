  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=25.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app",
    "build:app": "npm run audit:observability && tsc -b && vite build",
    "obfuscate:dist": "node scripts/obfuscate-dist.mjs",
    "build:prod": "npm run build:app && npm run obfuscate:dist",
    "audit:observability": "node scripts/observability-audit.mjs",
    "lint": "eslint .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:backend-integration": "vitest --config vitest.backend.config.ts --run",
    "test:ci": "npm run audit:observability && vitest --run --coverage --maxWorkers=4",
    "coverage:project": "node scripts/check-project-coverage.mjs --min=80",
    "docs:check": "node scripts/docs-validate.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
