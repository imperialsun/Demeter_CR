    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "javascript-obfuscator": "^5.5.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.1",
    "terser": "^5.49.0",
    "typescript": "~7.0.2",
