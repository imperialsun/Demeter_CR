:3000 {
    root * /srv
    encode gzip zstd
    try_files {path} /index.html
    file_server

    # Security headers for cross-origin isolation (needed for WASM multithreading/SharedArrayBuffer)
    header {
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Embedder-Policy "require-corp"
        Cross-Origin-Resource-Policy "same-origin"
        Referrer-Policy "no-referrer-when-downgrade"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # Cache policy tuned for SPA + heavy runtime assets.
    @index path /index.html
    @assets path /assets/*
    @onnx path /onnx/*
    @ffmpeg path /ffmpeg/*
    @worklets path /worklets/*
    header @index Cache-Control "no-cache"
    header @assets Cache-Control "public, max-age=31536000, immutable"
    header @onnx Cache-Control "public, max-age=86400, must-revalidate"
    header @ffmpeg Cache-Control "public, max-age=86400, must-revalidate"
    header @worklets Cache-Control "public, max-age=3600, must-revalidate"

    # Ensure correct MIME type for WASM (Caddy normally does this)
    @wasm {
        path *.wasm
    }
    header @wasm Content-Type application/wasm
}
