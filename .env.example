# Frontend runtime mode
APP_RUNTIME_MODE=backend

# Development example:
# keep a relative API base and let Vite proxy /api/* to the local backend.
APP_BACKEND_BASE_URL=/api/v1
DEV_BACKEND_PROXY_TARGET=http://localhost:8080

# Build-time login password example.
# Replace with a strong value in real environments.
LOGIN_PASSWORDS=change-me

# Production example:
# APP_BACKEND_BASE_URL=https://backend.transcode.demeter-sante.fr/api/v1
# DEV_BACKEND_PROXY_TARGET=
